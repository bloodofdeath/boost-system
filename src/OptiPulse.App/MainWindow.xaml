<Window x:Class="OptiPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OptiPulse — Windows Gaming &amp; PC Optimizer"
        Width="1260" Height="820"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F13"
        Foreground="#F3F5F8"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#1F2430" BorderThickness="1" Background="#0D0F13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== TOP HEADER BAR ==================== -->
            <Border Grid.Row="0" Background="#111319" BorderBrush="#1E232E" BorderThickness="0,0,0,1" Padding="20,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#152B23" BorderBrush="#245944" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconPulseLogo}" Stroke="#34E59E" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="18" Height="18" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="OptiPulse" FontSize="15.5" FontWeight="Bold" Foreground="#F3F5F8"/>
                                <Border Background="#1B2230" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="#7E889B"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="FPS Boost &amp; PC Diagnostics" FontSize="10.5" Foreground="#6D7588"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton Content="Оптимизация" Style="{StaticResource HeaderNavTabStyle}" GroupName="MainNav"
                                     IsChecked="{Binding SelectedMainTab, Converter={StaticResource IntEqToBool}, ConverterParameter=0}" Margin="0,0,4,0"/>
                        <RadioButton Content="Анализ ПК и Отчёт" Style="{StaticResource HeaderNavTabStyle}" GroupName="MainNav"
                                     IsChecked="{Binding SelectedMainTab, Converter={StaticResource IntEqToBool}, ConverterParameter=1}" Margin="0,0,4,0"/>
                        <RadioButton Content="Бэкапы" Style="{StaticResource HeaderNavTabStyle}" GroupName="MainNav"
                                     IsChecked="{Binding SelectedMainTab, Converter={StaticResource IntEqToBool}, ConverterParameter=2}" Margin="0,0,4,0"/>
                        <RadioButton Content="Журнал" Style="{StaticResource HeaderNavTabStyle}" GroupName="MainNav"
                                     IsChecked="{Binding SelectedMainTab, Converter={StaticResource IntEqToBool}, ConverterParameter=3}"/>
                    </StackPanel>

                    <!-- Right Action Controls: Analyze PC + Admin Status Pill -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Prominent PC Analysis Button -->
                        <Button Command="{Binding RunPcAnalysisCommand}" Style="{StaticResource MintPrimaryButton}" Padding="14,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconScan}" Fill="#081611" Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
                                <TextBlock Text="Анализ ПК" FontWeight="Bold" FontSize="12.5"/>
                            </StackPanel>
                        </Button>

                        <!-- Admin Shield Status Button -->
                        <Button Command="{Binding RequestAdminCommand}" Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AdminPill" CornerRadius="8" Padding="11,6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#251E12"/>
                                                <Setter Property="BorderBrush" Value="#5C441A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                        <Setter Property="Background" Value="#13261F"/>
                                                        <Setter Property="BorderBrush" Value="#215440"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconShield}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                                <Setter Property="Fill" Value="#34E59E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding AdminBadgeText}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FCD34D"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                                <Setter Property="Foreground" Value="#34E59E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Window Caption Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="─" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Свернуть"/>
                        <Button x:Name="MaximizeBtn" Content="▢" Style="{StaticResource CaptionButtonStyle}" Click="Maximize_Click" ToolTip="Развернуть"/>
                        <Button Content="✕" Style="{StaticResource CaptionCloseButtonStyle}" Click="Close_Click" ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== OPTIONAL REBOOT BANNER ==================== -->
            <Border Grid.Row="1"
                    Visibility="{Binding IsRebootBannerVisible, Converter={StaticResource BoolToVis}}"
                    Background="#152036" BorderBrush="#263B63" BorderThickness="0,0,0,1" Padding="24,9">
                <Grid>
                    <TextBlock Text="↻ Некоторые применённые системные параметры (драйвер GPU / NTFS) вступят в полную силу после перезагрузки Windows."
                               Foreground="#93C5FD" FontSize="12.5" VerticalAlignment="Center"/>
                    <Button Content="Скрыть" Style="{StaticResource DarkSecondaryButton}" Padding="10,4" FontSize="11.5"
                            HorizontalAlignment="Right" Command="{Binding DismissRebootBannerCommand}"/>
                </Grid>
            </Border>

            <!-- ==================== MAIN CONTENT AREA ==================== -->
            <Grid Grid.Row="2">

                <!-- ========================================================= -->
                <!-- TAB 0: OPTIMIZATIONS (14 CARDS GRID)                      -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource IntEqToVis}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: Filter pills + Live Startup Check Counter + Search + Quick Actions -->
                    <Border Grid.Row="0" Padding="24,18,24,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Category pills + verified status counter -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Все (14)" Style="{StaticResource FilterPillStyle}" GroupName="CatFilter" IsChecked="True"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="ALL"/>
                                <RadioButton Content="Включённые" Style="{StaticResource FilterPillStyle}" GroupName="CatFilter"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="ACTIVE"/>
                                <RadioButton Content="Выключенные" Style="{StaticResource FilterPillStyle}" GroupName="CatFilter"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="INACTIVE"/>
                                <RadioButton Content="GPU и Игры" Style="{StaticResource FilterPillStyle}" GroupName="CatFilter"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="GPU"/>
                                <RadioButton Content="CPU и Система" Style="{StaticResource FilterPillStyle}" GroupName="CatFilter"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="CPU"/>
                                <RadioButton Content="Сеть и Ввод" Style="{StaticResource FilterPillStyle}" GroupName="CatFilter"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="NET"/>
                                <RadioButton Content="Диск и ОЗУ" Style="{StaticResource FilterPillStyle}" GroupName="CatFilter"
                                             Command="{Binding SelectCategoryCommand}" CommandParameter="DISK"/>

                                <Border Background="#152620" BorderBrush="#204D3B" BorderThickness="1" CornerRadius="14" Padding="10,4" Margin="6,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveCounterText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#34E59E"/>
                                </Border>
                            </StackPanel>

                            <!-- Right: Search + Gaming Preset + Refresh -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="190" Margin="0,0,10,0">
                                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkSearchTextBox}"/>
                                    <TextBlock Text="Поиск функций..." IsHitTestVisible="False" Foreground="#5F6778" FontSize="12.5"
                                               VerticalAlignment="Center" Margin="13,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Command="{Binding ApplyGamingPresetCommand}" Style="{StaticResource DarkSecondaryButton}" Margin="0,0,8,0"
                                        ToolTip="Включить рекомендованный набор игровых оптимизаций с авто-бэкапом">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconBolt}" Fill="#34E59E" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Игровой пресет"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RefreshStatusesCommand}" Style="{StaticResource DarkSecondaryButton}" Padding="10,7" ToolTip="Проверить реальные статусы Windows заново">
                                    <Path Data="{StaticResource IconRefresh}" Fill="#9BA3B4" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3-Column Tweak Cards Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,8,28">
                        <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,16,16"
                                            Padding="20,18"
                                            MinHeight="178"
                                            CornerRadius="10"
                                            BorderThickness="1"
                                            ToolTip="{Binding StatusNote}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#17191F"/>
                                                <Setter Property="BorderBrush" Value="#212530"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1B1E26"/>
                                                        <Setter Property="BorderBrush" Value="#313748"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Card Top Row: Icon + (Optional Info/Warning Badge) + Mint Toggle -->
                                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Feature Vector Icon -->
                                                <Path Grid.Column="0"
                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                                      Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="#7D8596"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Fill" Value="#9CA7BA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <!-- Right Controls: Notice "!" Badge + Pill Switch -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Visibility="{Binding NoticeLevel, Converter={StaticResource NoticeLevelToVis}}"
                                                            Background="{Binding NoticeLevel, Converter={StaticResource NoticeLevelToBrush}}"
                                                            Width="18" Height="18" CornerRadius="9"
                                                            Margin="0,0,10,0" VerticalAlignment="Center"
                                                            ToolTip="{Binding NoticeTooltip}" Cursor="Help">
                                                        <TextBlock Text="!" FontSize="11.5" FontWeight="ExtraBold" Foreground="#0D0F13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </Border>

                                                    <CheckBox Style="{StaticResource PulseToggleStyle}"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Card Middle: Title (+ Beta Pill) & Description -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14.5" FontWeight="Bold" Foreground="#F3F5F8"
                                                               TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <Border Visibility="{Binding IsBeta, Converter={StaticResource BoolToVis}}"
                                                            Background="#1B2A47" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="Бета" FontSize="10.5" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12.5" Foreground="#8A92A3"
                                                           TextWrapping="Wrap" LineHeight="17.5"/>
                                            </StackPanel>

                                            <!-- Card Bottom: "Не рекомендуется, если..." Link + Live System Status Pill -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Content="Не рекомендуется, если..."
                                                        Style="{StaticResource NotRecommendedLinkButton}"
                                                        Command="{Binding ShowNotRecommendedCommand}"/>

                                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        CornerRadius="10" Padding="8,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1E222B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Background" Value="#132920"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Выкл"/>
                                                                <Setter Property="Foreground" Value="#757E91"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="● Включено"/>
                                                                        <Setter Property="Foreground" Value="#34E59E"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ========================================================= -->
                <!-- TAB 1: PC ANALYZER & DIAGNOSTICS REPORT                   -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource IntEqToVis}, ConverterParameter=1}" Margin="24,18,24,20">

                    <!-- Empty State Before First Analysis -->
                    <Border Visibility="{Binding ShowAnalyzerEmptyState, Converter={StaticResource BoolToVis}}"
                            Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="14"
                            MaxWidth="700" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="16" Background="#142921" BorderBrush="#215440" BorderThickness="1" Margin="0,0,0,18">
                                <Path Data="{StaticResource IconScan}" Fill="#34E59E" Width="30" Height="30" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Глубокий анализ производительности ПК" FontSize="22" FontWeight="Bold" Foreground="#F3F5F8" HorizontalAlignment="Center"/>
                            <TextBlock Text="OptiPulse проверит процессор, видеокарту, ОЗУ, реальные типы дисков (NVMe / SATA SSD / HDD), схему питания, автозагрузку (с учётом Диспетчера задач), фоновые процессы и ненужные службы Windows — и сформирует точный отчёт, что можно выключить для ускорения ПК."
                                       FontSize="13.5" Foreground="#949CAE" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="0,10,0,22"/>
                            <Button Command="{Binding RunPcAnalysisCommand}" Style="{StaticResource MintPrimaryButton}" Padding="26,11" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconScan}" Fill="#081611" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Запустить анализ ПК" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Анализ работает в режиме только чтения — безопасен и не требует прав администратора."
                                       FontSize="11.5" Foreground="#666E7F" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Scanning Progress State -->
                    <Border Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"
                            Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="14"
                            MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="34">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Идёт диагностика системы..." FontSize="18" FontWeight="Bold" Foreground="#F3F5F8" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AnalysisProgressText}" FontSize="13" Foreground="#34E59E" HorizontalAlignment="Center" Margin="0,8,0,18"/>
                            <ProgressBar IsIndeterminate="True" Height="6" Width="380" Foreground="#34E59E" Background="#252A36" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Full Interactive Report View -->
                    <Grid Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Score Hero Banner + Export Controls -->
                        <Border Grid.Row="0" Background="#17191F" BorderBrush="#242937" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Live Dynamic Score Box -->
                                <Border Grid.Column="0" Background="#101218" BorderBrush="#262C3A" BorderThickness="1" CornerRadius="10"
                                        Padding="18,10" Margin="0,0,20,0" MinWidth="112">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LiveReportScore}"
                                                   Foreground="{Binding LiveReportScore, Converter={StaticResource ScoreToBrush}}"
                                                   FontSize="34" FontWeight="ExtraBold" HorizontalAlignment="Center" LineHeight="36"/>
                                        <TextBlock Text="из 100" FontSize="11.5" Foreground="#7E8699" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Verdict & Summary Counters -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LiveReportVerdict}" FontSize="16" FontWeight="Bold" Foreground="#F3F5F8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Background="#2B171B" CornerRadius="6" Padding="9,4" Margin="0,0,8,0">
                                            <TextBlock FontSize="11.5" Foreground="#FCA5A5">
                                                <Run Text="Высокий эффект: "/><Run Text="{Binding HighImpactCount, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#2A2213" CornerRadius="6" Padding="9,4" Margin="0,0,8,0">
                                            <TextBlock FontSize="11.5" Foreground="#FCD34D">
                                                <Run Text="Средний: "/><Run Text="{Binding MediumImpactCount, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#182236" CornerRadius="6" Padding="9,4" Margin="0,0,8,0">
                                            <TextBlock FontSize="11.5" Foreground="#93C5FD">
                                                <Run Text="Низкий: "/><Run Text="{Binding LowImpactCount, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#132820" CornerRadius="6" Padding="9,4">
                                            <TextBlock FontSize="11.5" Foreground="#34E59E">
                                                <Run Text="Уже оптимизировано: "/><Run Text="{Binding ReportAlreadyOptimized.Count, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Report Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding ApplySafeRecommendationsCommand}" Style="{StaticResource MintPrimaryButton}" Margin="0,0,8,0"
                                            ToolTip="Применить все основные рекомендации с пометкой «Безопасно»">
                                        <TextBlock Text="⚡ Ускорить (безопасные)"/>
                                    </Button>
                                    <Button Command="{Binding ExportReportCommand}" Style="{StaticResource DarkSecondaryButton}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconExport}" Fill="#34E59E" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Сохранить отчёт"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CopyMarkdownReportCommand}" Style="{StaticResource DarkSecondaryButton}" Content="Копировать MD" Margin="0,0,8,0"/>
                                    <Button Command="{Binding RunPcAnalysisCommand}" Style="{StaticResource DarkSecondaryButton}" Padding="10,7" ToolTip="Повторить сканирование">
                                        <Path Data="{StaticResource IconRefresh}" Fill="#9BA3B4" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Hardware Specs Row (4 Cards) -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                            <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ПРОЦЕССОР" FontSize="10.5" FontWeight="Bold" Foreground="#6D7588"/>
                                    <TextBlock Text="{Binding CurrentReport.Hardware.CpuName}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F5F8" TextTrimming="CharacterEllipsis" Margin="0,4,0,2" ToolTip="{Binding CurrentReport.Hardware.CpuName}"/>
                                    <TextBlock FontSize="11.5" Foreground="#8E95A5">
                                        <Run Text="{Binding CurrentReport.Hardware.CpuCores, Mode=OneWay}"/><Run Text=" ядер / "/><Run Text="{Binding CurrentReport.Hardware.CpuThreads, Mode=OneWay}"/><Run Text=" пот. • Нагрузка: "/><Run Text="{Binding CurrentReport.Hardware.CpuLoadPercent, Mode=OneWay, StringFormat={}{0:0.#}%}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ВИДЕОКАРТА" FontSize="10.5" FontWeight="Bold" Foreground="#6D7588"/>
                                    <TextBlock Text="{Binding CurrentReport.Hardware.PrimaryGpuName}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F5F8" TextTrimming="CharacterEllipsis" Margin="0,4,0,2" ToolTip="{Binding CurrentReport.Hardware.PrimaryGpuName}"/>
                                    <TextBlock FontSize="11.5" Foreground="#8E95A5">
                                        <Run Text="Драйвер: "/><Run Text="{Binding CurrentReport.Hardware.GpuDriverVersion, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" FontSize="10.5" FontWeight="Bold" Foreground="#6D7588"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#F3F5F8" Margin="0,4,0,2">
                                        <Run Text="{Binding CurrentReport.Hardware.UsedRamGb, Mode=OneWay, StringFormat={}{0:0.0}}"/><Run Text=" / "/><Run Text="{Binding CurrentReport.Hardware.TotalRamGb, Mode=OneWay, StringFormat={}{0:0.0}}"/><Run Text=" ГБ ("/><Run Text="{Binding CurrentReport.Hardware.RamUsagePercent, Mode=OneWay, StringFormat={}{0:0.#}%}"/><Run Text=")"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11.5" Foreground="#8E95A5">
                                        <Run Text="Свободно: "/><Run Text="{Binding CurrentReport.Hardware.FreeRamGb, Mode=OneWay, StringFormat={}{0:0.0}}"/><Run Text=" ГБ"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="ПИТАНИЕ И ДИСКИ" FontSize="10.5" FontWeight="Bold" Foreground="#6D7588"/>
                                    <TextBlock Text="{Binding CurrentReport.Hardware.ActivePowerPlanName}" FontSize="13" FontWeight="SemiBold" Foreground="#F3F5F8" TextTrimming="CharacterEllipsis" Margin="0,4,0,2" ToolTip="{Binding CurrentReport.Hardware.ActivePowerPlanName}"/>
                                    <TextBlock Text="{Binding ReportDisksSummary}" FontSize="11.5" Foreground="#8E95A5" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReportDisksSummary}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Sub-tabs inside Report -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="ReportSubNav"
                                             IsChecked="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToBool}, ConverterParameter=0}">
                                    <TextBlock><Run Text="Что выключить / ускорить ("/><Run Text="{Binding AllReportRecommendations.Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                                </RadioButton>
                                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="ReportSubNav"
                                             IsChecked="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToBool}, ConverterParameter=1}">
                                    <TextBlock><Run Text="Автозагрузка ("/><Run Text="{Binding ReportStartupApps.Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                                </RadioButton>
                                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="ReportSubNav"
                                             IsChecked="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToBool}, ConverterParameter=2}">
                                    <TextBlock><Run Text="Фоновые процессы ("/><Run Text="{Binding ReportTopProcesses.Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                                </RadioButton>
                                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="ReportSubNav"
                                             IsChecked="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToBool}, ConverterParameter=3}">
                                    <TextBlock><Run Text="Уже оптимизировано ("/><Run Text="{Binding ReportAlreadyOptimized.Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                                </RadioButton>
                            </StackPanel>

                            <!-- Category Filter for Recommendations Sub-tab -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToVis}, ConverterParameter=0}">
                                <RadioButton Content="Все" Style="{StaticResource FilterPillStyle}" GroupName="RecCatFilter" IsChecked="True"
                                             Command="{Binding SelectReportCategoryCommand}" CommandParameter="ALL"/>
                                <RadioButton Content="Игры и Система" Style="{StaticResource FilterPillStyle}" GroupName="RecCatFilter"
                                             Command="{Binding SelectReportCategoryCommand}" CommandParameter="SYS"/>
                                <RadioButton Content="Службы" Style="{StaticResource FilterPillStyle}" GroupName="RecCatFilter"
                                             Command="{Binding SelectReportCategoryCommand}" CommandParameter="SVC"/>
                                <RadioButton Content="Автозагрузка" Style="{StaticResource FilterPillStyle}" GroupName="RecCatFilter"
                                             Command="{Binding SelectReportCategoryCommand}" CommandParameter="STARTUP"/>
                                <RadioButton Content="Оформление" Style="{StaticResource FilterPillStyle}" GroupName="RecCatFilter"
                                             Command="{Binding SelectReportCategoryCommand}" CommandParameter="VISUAL"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sub-tab 0: Actionable Recommendations -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToVis}, ConverterParameter=0}">
                            <ItemsControl ItemsSource="{Binding FilteredReportRecommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" Foreground="#F3F5F8" Margin="0,0,10,0"/>
                                                        <Border Background="{Binding Impact, Converter={StaticResource ImpactToBrush}}" CornerRadius="10" Padding="8,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Impact, Converter={StaticResource ImpactToText}}"
                                                                       Foreground="{Binding Impact, Converter={StaticResource ImpactToFg}}"
                                                                       FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="#1B202B" CornerRadius="10" Padding="8,2">
                                                            <TextBlock Text="{Binding Safety, Converter={StaticResource SafetyToText}}"
                                                                       Foreground="{Binding Safety, Converter={StaticResource SafetyToFg}}"
                                                                       FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#C4CBD9" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                    <TextBlock FontSize="11.5" Foreground="#7A8396" TextWrapping="Wrap">
                                                        <Run Text="Сейчас: " FontWeight="SemiBold"/><Run Text="{Binding CurrentState, Mode=OneWay}"/>
                                                        <Run Text="   •   Польза: " FontWeight="SemiBold"/><Run Text="{Binding ExpectedBenefit, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button Content="{Binding ActionButtonLabel}"
                                                            Command="{Binding ApplyCommand}"
                                                            Style="{StaticResource MintPrimaryButton}"
                                                            Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"
                                                            MinWidth="135"/>
                                                    <Border Visibility="{Binding IsResolved, Converter={StaticResource BoolToVis}}"
                                                            Background="#142921" BorderBrush="#235742" BorderThickness="1" CornerRadius="8" Padding="12,7">
                                                        <TextBlock Text="✓ Применено" Foreground="#34E59E" FontSize="12" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Sub-tab 1: Startup Programs -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToVis}, ConverterParameter=1}">
                            <ItemsControl ItemsSource="{Binding ReportStartupApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#F3F5F8"/>
                                                        <Border Visibility="{Binding IsRecommendedToDisable, Converter={StaticResource BoolToVis}}"
                                                                Background="#2B2113" CornerRadius="6" Padding="7,2" Margin="8,0,0,0">
                                                            <TextBlock Text="Рекомендуется отключить" FontSize="11" FontWeight="SemiBold" Foreground="#FCD34D"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RecommendationReason}" FontSize="12" Foreground="#9AA2B3" Margin="0,4,0,2"/>
                                                    <TextBlock FontSize="11" Foreground="#666E7F" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}">
                                                        <Run Text="{Binding Location, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Command, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button Content="Отключить" Command="{Binding DisableCommand}"
                                                            Style="{StaticResource DarkSecondaryButton}"
                                                            Visibility="{Binding IsDisabled, Converter={StaticResource InvBoolToVis}}"/>
                                                    <TextBlock Text="{Binding DisabledStatusText}" Foreground="#34E59E" FontWeight="SemiBold" FontSize="12"
                                                               Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Sub-tab 2: Top Background Processes (with safe Close action) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToVis}, ConverterParameter=2}">
                            <ItemsControl ItemsSource="{Binding ReportTopProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="115"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#F3F5F8"/>
                                                    <TextBlock FontSize="11" Foreground="#7A8396">
                                                        <Run Text="Процессов: "/><Run Text="{Binding InstanceCount, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#34E59E"
                                                           Text="{Binding MemoryMb, StringFormat={}{0:0.#} МБ}"/>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" Foreground="#A5AEBF"
                                                           Text="{Binding Note}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <Button Content="Завершить" Command="{Binding CloseProcessCommand}"
                                                            Style="{StaticResource DarkSecondaryButton}"
                                                            Visibility="{Binding IsClosed, Converter={StaticResource InvBoolToVis}}"/>
                                                    <TextBlock Text="✓ Завершён" Foreground="#34E59E" FontSize="12" FontWeight="SemiBold"
                                                               Visibility="{Binding IsClosed, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Sub-tab 3: Already Optimized -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedReportSubTab, Converter={StaticResource IntEqToVis}, ConverterParameter=3}">
                            <ItemsControl ItemsSource="{Binding ReportAlreadyOptimized}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#12211B" BorderBrush="#1F4A3A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                            <TextBlock FontSize="13" Foreground="#A7F3D0">
                                                <Run Text="✓  " Foreground="#34E59E" FontWeight="Bold"/><Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ========================================================= -->
                <!-- TAB 2: BACKUPS & SYSTEM RESTORE                           -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource IntEqToVis}, ConverterParameter=2}" Margin="24,18,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Резервные копии и безопасность системы" FontSize="17" FontWeight="Bold" Foreground="#F3F5F8"/>
                                <TextBlock Text="Перед каждым изменением реестра, служб, схемы питания или Engine.ini сохраняется точное исходное состояние. Вы можете откатить любую опцию отдельно или вернуть всё одной кнопкой."
                                           FontSize="12.5" Foreground="#8E95A5" TextWrapping="Wrap" Margin="0,4,20,0"/>
                                <TextBlock FontSize="11.5" Foreground="#666E7F" Margin="0,6,0,0">
                                    <Run Text="Папка бэкапов: "/><Run Text="{Binding BackupDirectoryPath, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🛡 Точка восстановления Windows" Command="{Binding CreateRestorePointCommand}"
                                        Style="{StaticResource MintPrimaryButton}" Margin="0,0,10,0"/>
                                <Button Content="Открыть папку" Command="{Binding OpenBackupFolderCommand}"
                                        Style="{StaticResource DarkSecondaryButton}" Margin="0,0,10,0"/>
                                <Button Content="↺ Откатить всё" Command="{Binding RevertAllCommand}"
                                        Style="{StaticResource DangerOutlineButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Border Visibility="{Binding HasBackups, Converter={StaticResource InvBoolToVis}}"
                                Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="12" Padding="32"
                                VerticalAlignment="Top">
                            <TextBlock Text="Пока нет сохранённых резервных копий — они автоматически появятся здесь, как только вы включите любую оптимизацию или отключите службу/элемент автозагрузки."
                                       Foreground="#8E95A5" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>

                        <ScrollViewer Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BackupItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#17191F" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#1D2330" CornerRadius="6" Padding="9,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F3F5F8"/>
                                                    <TextBlock FontSize="11.5" Foreground="#8E95A5" Margin="0,2,0,0">
                                                        <Run Text="{Binding Details, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding SavedAtText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Восстановить" Command="{Binding RestoreCommand}"
                                                        Style="{StaticResource DarkSecondaryButton}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ========================================================= -->
                <!-- TAB 3: TRANSPARENT ACTIVITY LOG                           -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding SelectedMainTab, Converter={StaticResource IntEqToVis}, ConverterParameter=3}" Margin="24,18,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Журнал действий (прозрачный аудит)" FontSize="17" FontWeight="Bold" Foreground="#F3F5F8"/>
                            <TextBlock Text="Все системные команды, изменения реестра, служб и результаты анализа записываются в реальном времени."
                                       FontSize="12.5" Foreground="#8E95A5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Открыть папку логов" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource DarkSecondaryButton}" Margin="0,0,8,0"/>
                            <Button Content="Очистить" Command="{Binding ClearLogsCommand}" Style="{StaticResource DarkSecondaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#12141A" BorderBrush="#232836" BorderThickness="1" CornerRadius="10" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" FontFamily="Consolas" FontSize="12" Foreground="#666E7F"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" FontFamily="Consolas" FontSize="12" Foreground="#7E89A1" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== TOAST NOTIFICATION ==================== -->
                <Border Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,20" MaxWidth="460"
                        CornerRadius="10" Padding="16,12" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#142921"/>
                            <Setter Property="BorderBrush" Value="#26634B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                    <Setter Property="Background" Value="#2B161B"/>
                                    <Setter Property="BorderBrush" Value="#692B36"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
                    </Border.Effect>
                    <TextBlock Text="{Binding ToastMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F3F5F8" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
