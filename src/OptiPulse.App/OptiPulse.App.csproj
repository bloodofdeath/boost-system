<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OptiPulse</AssemblyName>
    <RootNamespace>OptiPulse.App</RootNamespace>
    <Version>1.0.0</Version>
    <Product>OptiPulse — Windows Gaming &amp; PC Optimizer</Product>
    <Description>Open-source Windows gaming and system optimization toolkit with PC diagnostics and report export.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptiPulse.Core\OptiPulse.Core.csproj" />
  </ItemGroup>

</Project>
