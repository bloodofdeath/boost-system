<Application x:Class="OptiPulse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OptiPulse.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
            <conv:InverseBoolConverter x:Key="InvBool"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqToVis"/>
            <conv:IntEqualsToBoolConverter x:Key="IntEqToBool"/>
            <conv:NoticeLevelToBrushConverter x:Key="NoticeLevelToBrush"/>
            <conv:NoticeLevelToVisibilityConverter x:Key="NoticeLevelToVis"/>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
            <conv:ImpactToTextConverter x:Key="ImpactToText"/>
            <conv:ImpactToBrushConverter x:Key="ImpactToBrush"/>
            <conv:ImpactToForegroundConverter x:Key="ImpactToFg"/>
            <conv:SafetyToTextConverter x:Key="SafetyToText"/>
            <conv:SafetyToForegroundConverter x:Key="SafetyToFg"/>
            <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
            <conv:ScoreToBrushConverter x:Key="ScoreToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
