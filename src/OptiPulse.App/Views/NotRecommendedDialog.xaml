<Window x:Class="OptiPulse.App.Views.NotRecommendedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация об оптимизации"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#151820"
            BorderBrush="#2E3546"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.65"/>
        </Border.Effect>

        <StackPanel Margin="24">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="10" Background="#1D222E" Margin="0,0,14,0">
                    <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                          Fill="#34E59E" Width="22" Height="22" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#F3F5F8" TextWrapping="Wrap"/>
                        <Border Visibility="{Binding IsBeta, Converter={StaticResource BoolToVis}}"
                                Background="#1B2A47" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Бета" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusNote}" FontSize="12" Foreground="#8E95A5" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Style="{StaticResource CaptionCloseButtonStyle}"
                        VerticalAlignment="Top" Click="Close_Click"/>
            </Grid>

            <!-- Warning box: Не рекомендуется, если... -->
            <Border Background="#231B13" BorderBrush="#573E1C" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="⚠ Не рекомендуется, если..." FontSize="13" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding NotRecommendedWhen}" FontSize="13" Foreground="#E5E9F0" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </Border>

            <!-- Technical transparency box -->
            <Border Background="#11141B" BorderBrush="#232936" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Что именно делает эта опция (технические детали)" FontSize="12.5" FontWeight="SemiBold" Foreground="#93C5FD" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TechnicalDetails}" FontSize="12.5" Foreground="#B4BCCB" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- Requirement pills -->
            <WrapPanel Margin="0,0,0,18">
                <Border Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"
                        Background="#1E2330" CornerRadius="6" Padding="9,4" Margin="0,0,8,4">
                    <TextBlock Text="🛡 Требуются права администратора" FontSize="11.5" Foreground="#CBD5E1"/>
                </Border>
                <Border Visibility="{Binding RequiresRebootForFullEffect, Converter={StaticResource BoolToVis}}"
                        Background="#1C2538" CornerRadius="6" Padding="9,4" Margin="0,0,8,4">
                    <TextBlock Text="↻ Рекомендуется перезагрузка ПК" FontSize="11.5" Foreground="#93C5FD"/>
                </Border>
                <Border Background="#142921" CornerRadius="6" Padding="9,4" Margin="0,0,8,4">
                    <TextBlock Text="✓ Полностью обратимо (авто-бэкап)" FontSize="11.5" Foreground="#34E59E"/>
                </Border>
            </WrapPanel>

            <Button Content="Понятно" Style="{StaticResource MintPrimaryButton}" HorizontalAlignment="Right"
                    MinWidth="120" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
